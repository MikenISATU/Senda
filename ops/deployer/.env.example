# ops/deployer/.env.example  -  PLACEHOLDERS ONLY. Contains NO secret keys.
# Copy to ops/deployer/.env (git-ignored). The deployer SECRET never goes here:
# it lives in the Stellar CLI identity store (preferably --secure-store / OS keychain).

# Name of the Stellar CLI identity that signs testnet deployments.
# Create it once:  stellar keys generate senda-testnet-deployer --network testnet --fund --secure-store
SENDA_TESTNET_IDENTITY=senda-testnet-deployer

# Network. This script refuses anything other than "testnet".
STELLAR_NETWORK=testnet

# Circle's official TESTNET USDC issuer (verified in Paiflow docs + Circle faucet).
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Escrow roles (public G... addresses). Leave blank to default to the deployer address.
ESCROW_GUARDIAN=
ESCROW_MEDIATOR=
FEE_COLLECTOR_ADDRESS=

# Platform fee on freelancer payouts, in basis points (250 = 2.5%, max 1000).
ESCROW_FEE_BPS=250
# Client review window after proof submission, seconds (1-30 days). 604800 = 7 days.
ESCROW_REVIEW_PERIOD=604800

# Senda Earn vault (unaudited, testnet only). Blank pool/asset = Blend "TestnetV2"
# pool and Blend's testnet USDC from blend-utils testnet.contracts.json.
DEPLOY_EARN_VAULT=true
EARN_BLEND_POOL_ID=
EARN_ASSET_CONTRACT_ID=
EARN_DEPOSIT_CAP_STROOPS=10000000000
