# ─────────────────────────────────────────────────────────────────────────────
# SENDA - EXAMPLE ONLY. Copy to .env.local and fill in. NEVER commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: only public
# values go there. Everything else stays on the server.
# Full table (where to get each value, how to verify): docs/ENV_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Senda

# ── Stellar network ──────────────────────────────────────────────────────────
# testnet only until mainnet sign-off. Leave URLs/passphrase blank on testnet
# to use the official SDF endpoints; mainnet requires every value explicitly.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=
STELLAR_NETWORK_PASSPHRASE=
# Circle's official TESTNET USDC issuer. Mainnet uses a different issuer.
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Optional; derived automatically. If set, must match (the app checks).
STELLAR_USDC_ASSET_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_XLM_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (Project Settings > JWT Keys). Enables realtime chat under RLS.
# Optional: without it chat polls every 4 seconds.
SUPABASE_JWT_SECRET=

# ── Privy (email login + Stellar embedded wallets) ───────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# ── Paiflow (server only) ────────────────────────────────────────────────────
# Used for fixed-recipient routing (platform fee sweep via a Receive -> Split flow).
# Person-to-person sends, tips, purchases and escrow do NOT need Paiflow.
# See docs/PAIFLOW_SETUP.md for what each workflow id means.
PAIFLOW_API_BASE_URL=https://beta.app.paiflow.xyz
# pfd_... (developer token, Read and operate) or pfk_... (single deployment token)
PAIFLOW_API_KEY=
# Two flows, both On Receive > Split: one for USDC fees, one for XLM fees.
PAIFLOW_FEES_USDC_WORKFLOW_ID=
PAIFLOW_FEES_XLM_WORKFLOW_ID=
# Only for Paiflow "HTTP Webhook" trigger flows (x-webhook-secret). Unused by default.
PAIFLOW_WEBHOOK_SIGNING_SECRET=

# ── Contracts and platform addresses ─────────────────────────────────────────
# Deployed to testnet 2026-10-24 (ops/deployer/manifests/testnet-2026-10-24T14-51-22-296Z.json).
SOROBAN_JOB_ESCROW_CONTRACT_ID=CAPHY7BPH7T374NWFHZSSYEU24URTGREWW7XNSPENKALSPUJFIFVDUUN
# Senda Earn vault (pooled, unaudited). When set, Earn deposits/withdrawals go
# through this vault; testnet only unless EARN_VAULT_AUDITED=true after an audit.
SOROBAN_USDC_EARN_VAULT_CONTRACT_ID=CCHVH2MXKFSKC5WCWMGL3GGMPKA37UZTCJTUSLQMJDOKDFD6AOXURV67
# Blend v2 lending pool used by USDC Earn (Blend TestnetV2).
SOROBAN_YIELD_STRATEGY_CONTRACT_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
# Asset the pool lends (Blend's testnet USDC, not Circle's).
EARN_ASSET_CONTRACT_ID=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
# Public G... address that receives platform fees (tips, purchases). Use the
# admin's Senda wallet so fees can be swept through Paiflow from the Admin page.
FEE_COLLECTOR_ADDRESS=GCWPFDF44ISIKDKC6I4KCV6LP3BHHG55JWGEZJE4NTI4O6Q4ZPGF66SX
# Platform fee on tips and premium posts, basis points (250 = 2.5%).
PLATFORM_FEE_BPS=250
# Public address of the faucet treasury (must match FAUCET_TREASURY_SECRET).
TREASURY_PUBLIC_ADDRESS=GAJFQEBCRMK6REOVYEJRJKFFX3E5AONAO4M5HPL3SVPVQ7HLG5FYYNCO

# ── USDC Auto Earn ───────────────────────────────────────────────────────────
# OFF by default. 5% is an ILLUSTRATIVE display value, never a promised rate.
USDC_AUTO_EARN_ENABLED=false
USDC_TARGET_APR_DISPLAY=0.05
# Only set true after an independent audit of contracts/usdc_earn_vault. Required for mainnet vault use.
EARN_VAULT_AUDITED=false

# ── Testnet faucet ───────────────────────────────────────────────────────────
FAUCET_ENABLED=true
# TESTNET-ONLY hot wallet secret (S...). The app refuses to run the faucet on mainnet.
# Never reuse a key that holds anything of value. Set it in Vercel as a sensitive variable.
FAUCET_TREASURY_SECRET=
# New accounts are activated by Friendbot (10,000 test XLM), so this stays 0.
FAUCET_XLM_NEW_USER_AMOUNT=0
FAUCET_USDC_NEW_USER_AMOUNT=5
FAUCET_XLM_CLAIM_AMOUNT=20
FAUCET_USDC_CLAIM_AMOUNT=2
FAUCET_CLAIM_COOLDOWN_HOURS=24
# Max units of EACH asset the treasury sends per UTC day.
FAUCET_DAILY_TREASURY_CAP=200
FAUCET_MAX_CLAIMS_PER_IP_PER_DAY=3

# ── Operations ───────────────────────────────────────────────────────────────
# Random string; protects /api/cron/reconcile. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CRON_SECRET=
# Random string used to hash IP addresses for anti-abuse limits.
IP_HASH_SALT=
# Set true to send CSP as report-only while debugging browser errors.
CSP_REPORT_ONLY=false

# Deployer credentials are NOT stored in this file.
# ops/deployer uses the Stellar CLI identity store (OS keychain where supported).
